{
    "name": "tio2",
    "version": "1.0.0-preview.1",
    "description": "Static publishing for personal writing and knowledge sites, built on Eleventy and Vite.",
    "scripts": {
        "dev": "node bin/tio2.mjs dev --root examples/customized",
        "build": "node bin/tio2.mjs build --root examples/customized",
        "preview": "node bin/tio2.mjs preview --root examples/customized",
        "cms": "node bin/tio2.mjs cms --root examples/customized",
        "post:new": "node bin/tio2.mjs new --root examples/customized",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm cms:web:build && pnpm build",
        "test": "pnpm test:types && tsx --test tests/*/*.test.ts",
        "test:package": "node --test tests/release/packed-consumer.mjs",
        "test:types": "tsc --noEmit -p tsconfig.test.json",
        "test:core": "pnpm test:types && tsx --test tests/core/*.test.ts",
        "test:theme": "pnpm test:types && tsx --test tests/theme/*.test.ts",
        "test:scripts": "pnpm test:types && tsx --test tests/scripts/*.test.ts",
        "test:cms": "pnpm test:types && tsx --test tests/cms/*.test.ts tests/content-fs/*.test.ts",
        "cms:web:build": "TIO2_PROJECT_ROOT=examples/customized vite build --config apps/cms-web/vite.config.ts"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.28.1",
    "engines": {
        "node": ">=22.22.0 <23",
        "pnpm": "10.28.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "1.62.1",
        "@types/fs-extra": "^11.0.4",
        "@types/markdown-it": "^14.1.2",
        "@types/markdown-it-footnote": "3.0.4",
        "@types/node": "^22.15.32",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-vue": "^9.33.0",
        "globals": "^14.0.0",
        "juice": "8.1.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "vue-eslint-parser": "^9.4.3"
    },
    "dependencies": {
        "@11ty/eleventy": "3.1.6",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.13",
        "@fontsource-variable/noto-serif-sc": "5.3.0",
        "@mdit/plugin-attrs": "1.1.1",
        "@mdit/plugin-container": "1.0.2",
        "@otskit/core": "0.2.0",
        "@shikijs/transformers": "4.5.0",
        "@vercel/analytics": "^1.6.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "cytoscape": "^3.34.3",
        "cytoscape-cola": "2.5.1",
        "fastify": "^5.12.5",
        "fs-extra": "^11.4.1",
        "globby": "^14.1.0",
        "gray-matter": "^4.0.3",
        "markdown-it": "^14.3.2",
        "markdown-it-anchor": "^9.2.1",
        "markdown-it-cjk-friendly": "2.0.2",
        "markdown-it-footnote": "4.0.0",
        "markdown-it-mathjax3": "^4.3.2",
        "mathjax-full": "3.2.2",
        "minisearch": "7.1.2",
        "sharp": "^0.35.5",
        "shiki": "4.5.0",
        "tsx": "^4.23.15",
        "vite": "^8.3.3",
        "vue": "^3.5.43"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "private": true,
    "bin": {
        "tio2": "bin/tio2.mjs"
    },
    "exports": {
        ".": {
            "types": "./packages/config/src/index.d.ts",
            "import": "./packages/config/src/index.js"
        }
    },
    "files": [
        "bin/*.mjs",
        "packages/*/src",
        "site/*.ts",
        "site/*.mts",
        "site/*.mjs",
        "site/client",
        "site/public",
        ".vitepress/theme/*.ts",
        "apps/cms-server/src",
        "apps/cms-web/src",
        "apps/cms-web/index.html",
        "apps/cms-web/vite.config.ts",
        "scripts/register-ts.mjs",
        "scripts/run-site.mjs",
        "scripts/run-site-dev.mjs",
        "scripts/run-cms-dev.mjs",
        "scripts/run-cms-web.mts",
        "scripts/create-post.mjs",
        "scripts/build-search-index.ts",
        "scripts/write-site-artifacts.ts",
        "scripts/verify-site-client.ts",
        "scripts/verify-eleventy-site.ts",
        "docs/framework.md",
        "docs/releasing.md",
        "docs/third-party-notices.md",
        "examples/minimal",
        "LICENSE",
        "examples/customized",
        "docs/source-extraction.md"
    ]
}
